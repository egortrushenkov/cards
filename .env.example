# Токен бота из @BotFather (формат 123456789:AA...). В репозиторий не коммитить.
TELEGRAM_BOT_TOKEN=
# ID чата или группы, куда падают заявки (число, у групп со знаком минус).
TELEGRAM_CHAT_ID=
# Username менеджера без @ — подставляется в ссылку https://t.me/... при отдаче страницы.
MANAGER_USERNAME=
# Порт HTTP-сервера.
PORT=3000

# --- необязательные ---
# Домен сайта для canonical, sitemap и JSON-LD. Читается на этапе `npm run build`.
SITE_URL=https://example.ru
# Поставьте 1, если server.js стоит за nginx/Caddy: IP для лимита заявок
# будет браться из первого значения X-Forwarded-For.
TRUST_PROXY=0
